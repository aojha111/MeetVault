<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MeetVault light palette. Same keys as Dark.xaml; swapped at runtime by ThemeManager. -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="Bg.Header" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.Control" Color="#E8EAF0"/>
    <SolidColorBrush x:Key="Bg.Hover" Color="#DCE1EA"/>
    <SolidColorBrush x:Key="Bg.Popup" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Fg.Primary" Color="#1B1D24"/>
    <SolidColorBrush x:Key="Fg.Muted" Color="#616877"/>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Fg.Accent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border.Subtle" Color="#D4D8E0"/>
    <SolidColorBrush x:Key="Border.Separator" Color="#E3E6EB"/>
    <SolidColorBrush x:Key="Status.Good" Color="#157A46"/>
    <SolidColorBrush x:Key="Status.Warn" Color="#9A6A16"/>
    <SolidColorBrush x:Key="Status.Error.Fg" Color="#8F1D2C"/>
    <SolidColorBrush x:Key="Bg.Error" Color="#FBEAEC"/>

    <!-- WPF system-template selections (TreeView etc.) follow the palette. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6E4FF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B1D24"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E7ECF5"/>
</ResourceDictionary>
