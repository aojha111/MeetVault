<Window x:Class="MeetVault.App.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Manager"
        Height="560" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Window}"
        TextElement.Foreground="{DynamicResource Fg.Primary}"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Model Manager" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Model packs are downloaded separately; the app itself never bundles AI weights."/>
            <Border Background="{DynamicResource Bg.Card}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="HardwareText" Text="Detecting hardware…" TextWrapping="Wrap"/>
                        <TextBlock x:Name="RecommendationText" Style="{StaticResource Muted}" FontSize="11"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="RecommendedButton" Grid.Column="1" Style="{StaticResource ActionButton}"
                            Content="Install recommended set" Click="InstallRecommended_Click"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <CheckBox x:Name="OfflineModeCheck" Content="Offline Mode (disable all downloads)" Margin="0,10,0,0"
                      Checked="OfflineModeCheck_Changed" Unchecked="OfflineModeCheck_Changed"/>
        </StackPanel>

        <ListView x:Name="PacksList" Grid.Row="1" Margin="0,12,0,0" BorderThickness="0"
                  SelectionMode="Single" HorizontalContentAlignment="Stretch"
                  Background="{DynamicResource Bg.Card}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Pack.DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Pack.Group}" Margin="10,1,0,0" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="{Binding Description}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                           Text="{Binding SizeLabel, Mode=OneWay}"/>
                                <TextBlock x:Name="RamBadge" Margin="8,0,0,0" FontSize="11"
                                           Text="{Binding RamBadge, Mode=OneWay}"/>
                                <TextBlock x:Name="StateText" Margin="12,0,0,0" FontSize="11"
                                           Text="{Binding StateLabel, Mode=OneWay}"/>
                            </StackPanel>
                            <ProgressBar x:Name="PackProgress" Height="3" Minimum="0" Maximum="1"
                                         Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="InstallButton" Style="{StaticResource SmallButton}" Content="Install"
                                    Click="InstallButton_Click" Margin="0,0,6,0"/>
                            <Button x:Name="RemoveButton" Style="{StaticResource SmallButton}" Content="Remove"
                                    Click="RemoveButton_Click" Margin="0,0,6,0"/>
                            <Button x:Name="UseButton" Style="{StaticResource SmallButton}" Content="Use"
                                    ToolTip="Select this model for transcription/analysis/TTS"
                                    Click="UseButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter TargetName="InstallButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Status.Good}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="UseButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Fg.Muted}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NeedsMoreRam}" Value="True">
                            <Setter TargetName="RamBadge" Property="Foreground" Value="{DynamicResource Status.Warn}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="OverallProgress" Height="4" Minimum="0" Maximum="1"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="Close" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
