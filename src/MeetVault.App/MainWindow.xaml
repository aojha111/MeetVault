<Window x:Class="MeetVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetVault — Local Meeting Knowledge Vault"
        Height="720" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Window}"
        TextElement.Foreground="{DynamicResource Fg.Primary}"
        FontSize="13">
    <Window.Resources>
        <!-- Window-specific styles over the shared control theme -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Control}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
    </Window.Resources>

    <DockPanel>
        <!-- ── Header ─────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Header}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MeetVault" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="local-first meeting knowledge" Margin="10,2,0,0" Style="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="440" Style="{StaticResource SearchBox}"
                         Margin="20,0" KeyDown="SearchBox_KeyDown"/>
                <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="110" Margin="0,0,8,0" VerticalAlignment="Center"
                          ToolTip="Application theme" SelectedIndex="0" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem>Theme</ComboBoxItem>
                    <ComboBoxItem>System</ComboBoxItem>
                    <ComboBoxItem>Light</ComboBoxItem>
                    <ComboBoxItem>Dark</ComboBoxItem>
                </ComboBox>
                <Button x:Name="ModelManagerButton" Grid.Column="3" Style="{StaticResource GhostButton}"
                        Content="Models" Click="ModelManagerButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="AddButton" Grid.Column="4" Style="{StaticResource ActionButton}"
                        Content="+ Add Meeting" Click="AddButton_Click"/>
            </Grid>
        </Border>

        <!-- ── Status bar ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg.Header}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                <ProgressBar x:Name="StatusProgress" Grid.Column="1" Height="4" Margin="12,0" MinWidth="100"
                             Maximum="1" Visibility="Collapsed"/>
                <TextBlock x:Name="QueueText" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Body: meetings list + detail ───────────────────────── -->
        <Grid Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Meetings tree -->
            <Grid Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ComboBox x:Name="RangeCombo" SelectedIndex="0" SelectionChanged="RangeCombo_SelectionChanged">
                    <ComboBoxItem>All Meetings</ComboBoxItem>
                    <ComboBoxItem>Today</ComboBoxItem>
                    <ComboBoxItem>Yesterday</ComboBoxItem>
                    <ComboBoxItem>This Week</ComboBoxItem>
                    <ComboBoxItem>This Month</ComboBoxItem>
                </ComboBox>
                <TextBlock x:Name="MeetingCountText" Grid.Row="1" Margin="2,8,0,6" Style="{StaticResource Muted}"/>
                <TreeView x:Name="MeetingsTree" Grid.Row="2" Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="MeetingsTree_SelectedItemChanged" KeyDown="MeetingsTree_KeyDown">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Label}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="year">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="month-day">
                                                <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Detail pane -->
            <ScrollViewer Grid.Column="2" Margin="8,0,16,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Margin="4,0,8,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DetailTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="RenameMeetingButton" Style="{StaticResource SmallButton}"
                        Content="Rename" Click="RenameMeetingButton_Click"
                        Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="RenameMeetingTextBox" MinWidth="260" Visibility="Collapsed"
                         VerticalAlignment="Center" KeyDown="RenameMeetingTextBox_KeyDown"/>
                    <Button x:Name="SaveMeetingNameButton" Style="{StaticResource SmallButton}"
                        Content="Save" Click="SaveMeetingNameButton_Click"
                        Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <Button x:Name="CancelMeetingNameButton" Style="{StaticResource SmallButton}"
                        Content="Cancel" Click="CancelMeetingNameButton_Click"
                        Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="DetailDate" Style="{StaticResource Muted}" Margin="0,0,14,0"/>
                        <TextBlock x:Name="DetailDuration" Style="{StaticResource Muted}" Margin="0,0,14,0"/>
                                                <TextBlock x:Name="DetailStatus" Style="{StaticResource Muted}"/>
                        <Button x:Name="ProcessButton" Style="{StaticResource SmallButton}"
                                Content="Process" Click="ProcessButton_Click"
                                Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Audio brief player -->
                    <Border Background="{DynamicResource Bg.Card}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Audio Brief" FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <Button x:Name="RegenerateBriefButton" Style="{StaticResource SmallButton}"
                                            Content="Regenerate" Click="RegenerateBriefButton_Click"
                                            Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button x:Name="ExportButton" Style="{StaticResource SmallButton}"
                                            Content="Export…" Click="ExportButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource ActionButton}"
                                        Width="74" Content="Play" Click="PlayButton_Click"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="RestartButton" Style="{StaticResource SmallButton}" Content="⟲" Click="RestartButton_Click"
                                            ToolTip="Restart" Width="34"/>
                                    <ComboBox x:Name="SpeedCombo" Margin="6,0,0,0" Width="78" SelectedIndex="1"
                                              SelectionChanged="SpeedCombo_SelectionChanged" VerticalAlignment="Center">
                                        <ComboBoxItem>0.75×</ComboBoxItem>
                                        <ComboBoxItem>1×</ComboBoxItem>
                                        <ComboBoxItem>1.25×</ComboBoxItem>
                                        <ComboBoxItem>1.5×</ComboBoxItem>
                                        <ComboBoxItem>2×</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Text="Vol" Margin="10,0,4,0" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="1"
                                            ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                            Thumb.DragStarted="SeekSlider_DragStarted" Thumb.DragCompleted="SeekSlider_DragCompleted"
                                            ValueChanged="SeekSlider_ValueChanged"/>
                                </Grid>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock x:Name="CurrentTimeText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="00:00 / 00:00"/>
                                <TextBlock x:Name="PlayerHintText" Style="{StaticResource Muted}" Text="No audio brief generated yet."/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Error / retry -->
                    <Border x:Name="ErrorPanel" Background="{DynamicResource Bg.Error}" CornerRadius="8" Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Status.Error.Fg}"/>
                            <Button x:Name="RetryButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Retry"
                                    Margin="12,0,0,0" VerticalAlignment="Top" Click="RetryButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Analysis sections -->
                    <TextBlock Text="Summary" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>

                    <TextBlock Text="Agenda" Style="{StaticResource SectionHeader}" x:Name="AgendaHeader"/>
                    <ItemsControl x:Name="AgendaList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="•  " Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="620"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Key Discussion Points" Style="{StaticResource SectionHeader}" x:Name="DiscussionHeader"/>
                    <ItemsControl x:Name="DiscussionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="•  " Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="620"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Decisions" Style="{StaticResource SectionHeader}" x:Name="DecisionsHeader"/>
                    <ItemsControl x:Name="DecisionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="620"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Action Items" Style="{StaticResource SectionHeader}" x:Name="ActionsHeader"/>
                    <ItemsControl x:Name="ActionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="620"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Risks / Blockers" Style="{StaticResource SectionHeader}" x:Name="RisksHeader"/>
                    <ItemsControl x:Name="RisksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="620"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Open Questions" Style="{StaticResource SectionHeader}" x:Name="QuestionsHeader"/>
                    <ItemsControl x:Name="QuestionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="620"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Topics" Style="{StaticResource SectionHeader}" x:Name="TopicsHeader"/>
                    <WrapPanel x:Name="TopicsPanel"/>

                    <TextBlock Text="Related Meetings" Style="{StaticResource SectionHeader}" x:Name="RelatedHeader"/>
                    <StackPanel x:Name="RelatedPanel"/>

                    <TextBlock Text="Transcript" Style="{StaticResource SectionHeader}" x:Name="TranscriptHeader"/>
                    <ItemsControl x:Name="TranscriptList" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,3,0,3" TextWrapping="Wrap">
                                    <Run Text="{Binding Timecode, Mode=OneWay, FallbackValue=''}" Foreground="{DynamicResource Fg.Muted}"/>
                                    <Run Text="{Binding SpeakerPrefix, Mode=OneWay, FallbackValue=''}" Foreground="{DynamicResource Accent}"/>
                                    <Run Text="{Binding Text, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
